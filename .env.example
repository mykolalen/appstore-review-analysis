LOG_LEVEL=INFO
DEFAULT_PROVIDER=itunes
FIXTURE_DIR=data/fixtures
COLLECTION_CONCURRENCY=4
COLLECTION_TIMEOUT_S=10
COLLECTION_DEADLINE_S=45
COLLECTION_LOCK_WAIT_S=10
COLLECTION_MAX_REPLACEMENTS=20
HTTP_MAX_RETRIES=3
RSS_EMPTY_RETRIES=3
DATABASE_URL=sqlite:///data/app.db
REQUEST_DEADLINE_S=90
MODELS_DIR=models
THEME_DISTANCE_THRESHOLD=0.40
UNIT_MIN_NEGATIVE_SCORE_POSITIVE_REVIEWS=0.85
UNIT_MIN_NEGATIVE_SCORE_OTHER=0.50

# Optional public-demo mode. Deployment is still performed manually.
PUBLIC_MODE=false
PUBLIC_MAX_SAMPLE_SIZE=100
PUBLIC_GLOBAL_POST_LIMIT=10
PUBLIC_CLIENT_POST_LIMIT=5
PUBLIC_RATE_WINDOW_S=600
PUBLIC_SEED_ANALYSIS_PATH=reports/nebula_us_seed42.analysis.json
